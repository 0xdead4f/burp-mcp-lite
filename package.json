  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "keywords": [
    "burp",
    "burpsuite",
    "mcp",
    "model-context-protocol",
    "security",
    "proxy"
  ],
  "license": "MIT",
  "author": "0xdead4f",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xdead4f/burp-mcp-lite"
