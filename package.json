{
  "name": "burp-mcp-lite",
  "version": "0.2.0",
  "description": "Token-efficient middleware MCP server for Burp Suite proxy history.",
  "type": "module",
  "bin": {
    "burp-mcp-lite": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
